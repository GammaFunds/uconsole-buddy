{
  "description": "Gerald status, activity, and one-time physical approvals for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {"type": "command", "command": "python3 /absolute/path/to/uconsole-buddy/bridge/codex/gerald.py", "timeout": 5}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 /absolute/path/to/uconsole-buddy/bridge/codex/gerald.py", "timeout": 5}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "python3 /absolute/path/to/uconsole-buddy/bridge/codex/gerald.py", "timeout": 5}
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "python3 /absolute/path/to/uconsole-buddy/bridge/codex/gerald.py", "timeout": 110}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "python3 /absolute/path/to/uconsole-buddy/bridge/codex/gerald.py", "timeout": 3}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 /absolute/path/to/uconsole-buddy/bridge/codex/gerald.py", "timeout": 5}
        ]
      }
    ]
  }
}
